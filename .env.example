# Select exactly one primary provider and fill only its key for live runs.
CENTRALIGN_PROVIDER=groq
CENTRALIGN_FALLBACK_PROVIDER=

GROQ_API_KEY=
CENTRALIGN_GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
CENTRALIGN_GEMINI_MODEL=gemini-2.5-flash-lite

OPENAI_API_KEY=
CENTRALIGN_OPENAI_MODEL=gpt-4o

# Optional provider supported by the adapter:
OPENROUTER_API_KEY=
CENTRALIGN_OPENROUTER_MODEL=openrouter/free
